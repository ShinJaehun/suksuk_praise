<% teacher_avatar_keys = User.avatar_keys_for_role("teacher") %>
<% avatar_image_sources = teacher_avatar_keys.index_with { |avatar_key| asset_path("avatars/#{avatar_key}.png") } %>

<%= form_with model: teacher,
      url: admin_teachers_path,
      class: "space-y-5",
      data: {
        controller: "teacher-avatar-preview",
        teacher_avatar_preview_male_keys_value: User::TEACHER_MALE_AVATAR_KEYS,
        teacher_avatar_preview_female_keys_value: User::TEACHER_FEMALE_AVATAR_KEYS,
        teacher_avatar_preview_all_keys_value: teacher_avatar_keys,
        teacher_avatar_preview_image_sources_value: avatar_image_sources
      } do |f| %>
  <% if teacher.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700">
      <%= teacher.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= f.hidden_field :avatar_key, data: { teacher_avatar_preview_target: "avatarKey" } %>
  <div class="max-w-md space-y-5">
    <div>
      <%= f.label :name, t("ui.user_labels.name"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, class: "mt-1 block w-full border rounded px-3 py-2" %>
    </div>

    <div>
      <%= f.label :email, t("ui.user_labels.email"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, class: "mt-1 block w-full border rounded px-3 py-2" %>
    </div>

    <div>
      <%= f.label :password, t("admin.teachers.form.password_label"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password, class: "mt-1 block w-full border rounded px-3 py-2" %>
    </div>

    <div>
      <%= f.label :gender, t("admin.teachers.form.gender_label"), class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :gender,
            [[t("admin.teachers.form.gender_male"), "male"], [t("admin.teachers.form.gender_female"), "female"]],
            { include_blank: t("admin.teachers.form.gender_prompt") },
            class: "mt-1 block w-full border rounded px-3 py-2",
            data: {
              action: "teacher-avatar-preview#update",
              teacher_avatar_preview_target: "gender"
            } %>
    </div>
  </div>

  <div
    class="space-y-4"
    data-teacher-avatar-preview-target="avatarSection"
    <%= "hidden" unless User.avatar_keys_for(teacher.gender).include?(teacher.avatar_key) %>>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <%= user_avatar_image(
            teacher,
            size: 128,
            class: "h-20 w-20 shrink-0 rounded-xl border border-slate-200 bg-slate-100 object-cover",
            alt: "#{display_name(teacher)} avatar",
            data: { teacher_avatar_preview_target: "image" }
          ) %>
      <button type="button"
              class="inline-flex self-start items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
              aria-expanded="false"
              data-action="teacher-avatar-preview#togglePicker">
        <%= t("admin.teachers.form.avatar_select") %>
      </button>
    </div>

    <div hidden
         class="rounded-xl border border-slate-200 bg-slate-50 p-4"
         data-teacher-avatar-preview-target="picker">
      <div class="grid grid-cols-4 gap-3 sm:grid-cols-6 md:grid-cols-8">
        <% teacher_avatar_keys.each do |avatar_key| %>
          <button type="button"
                  class="relative flex items-center justify-center rounded-xl border border-slate-200 bg-white p-2 hover:border-blue-300"
                  aria-pressed="false"
                  data-avatar-key="<%= avatar_key %>"
                  data-action="teacher-avatar-preview#select"
                  data-teacher-avatar-preview-target="option">
            <%= image_tag "avatars/#{avatar_key}.png",
                  class: "h-12 w-12 rounded-lg object-cover",
                  alt: avatar_key %>
            <span hidden
                  class="absolute right-1 top-1 inline-flex h-5 w-5 items-center justify-center rounded-full bg-blue-600 text-xs font-bold text-white"
                  data-teacher-avatar-preview-target="check">✓</span>
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <%= render "admin/teachers/school_classroom_fields" %>

  <div>
    <%= f.submit t("ui.save"),
          data: { turbo_submits_with: t("admin.teachers.form.submitting") },
          class: "px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" %>
  </div>
<% end %>

<section class="mx-auto w-full max-w-6xl pt-4">
  <div class="mb-6 flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
    <div class="flex flex-col gap-3">
      <h1 class="text-2xl font-extrabold tracking-tight text-slate-900"><%= t("admin.teachers.index.title") %></h1>
      <%= form_with url: admin_teachers_path, method: :get, id: "teacher-school-filter", class: "flex flex-wrap items-end gap-2" do %>
        <div>
          <%= label_tag :school_id, t("filters.school.label"), class: "block text-xs font-semibold text-slate-500" %>
          <%= select_tag :school_id,
                options_for_select(
                  [[t("filters.school.all"), ""]] + @filter_schools.map { |school| [school.name, school.id] },
                  @selected_school&.id
                ),
                class: "mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </div>
        <div>
          <%= label_tag :status, t("teacher_status.filter_label"), class: "block text-xs font-semibold text-slate-500" %>
          <%= select_tag :status,
                options_for_select([
                  [t("teacher_status.active"), "active"],
                  [t("teacher_status.inactive"), "inactive"],
                  [t("teacher_status.all"), "all"]
                ], @teacher_status),
                class: "mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </div>
        <%= submit_tag t("filters.apply"),
              class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
      <% end %>
    </div>
    <%= link_to t("admin.teachers.index.add_teacher"),
          new_admin_teacher_path,
          class: "inline-flex w-full items-center justify-center rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-emerald-700 sm:w-auto" %>
  </div>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-5 py-4">
      <h2 class="text-lg font-bold text-slate-900"><%= t("admin.teachers.index.list_title") %></h2>
    </div>

    <% if @teacher_rows.any? %>
      <div class="divide-y divide-slate-200">
        <% @teacher_rows.each do |row| %>
          <% teacher = row[:teacher] %>
          <% classrooms = row[:classrooms] %>

          <article class="grid gap-4 px-5 py-4 <%= school_color_row_class(row[:school_color_key]) %> lg:grid-cols-[minmax(12rem,1.1fr)_minmax(9rem,0.8fr)_minmax(8rem,0.7fr)_minmax(14rem,1.4fr)_auto] lg:items-center">
            <div class="flex min-w-0 items-center gap-3">
              <%= user_avatar_image(
                    teacher,
                    size: 128,
                    class: "h-10 w-10 shrink-0 rounded-xl border border-slate-200 bg-slate-100 object-cover",
                    alt: "#{display_name(teacher)} avatar"
                  ) %>
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-900"><%= display_name(teacher) %></p>
                <p class="truncate text-xs text-slate-500"><%= teacher.email %></p>
                <span class="mt-1 inline-flex rounded-full px-2 py-0.5 text-xs font-semibold <%= teacher.active? ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-600" %>"><%= t(teacher.active? ? "teacher_status.active" : "teacher_status.inactive") %></span>
              </div>
            </div>

            <div>
              <p class="text-xs font-semibold text-slate-500"><%= t("admin.teachers.index.school") %></p>
              <% if row[:school_color_key] %>
                <p class="mt-1 flex items-center gap-1.5 truncate text-sm text-slate-800">
                  <span aria-hidden="true" class="h-2.5 w-2.5 shrink-0 rounded-full <%= school_color_swatch_class(row[:school_color_key]) %>"></span>
                  <span class="truncate"><%= row[:school_name] %></span>
                </p>
              <% else %>
                <span class="mt-1 inline-flex rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600"><%= row[:school_name] %></span>
              <% end %>
            </div>

            <div>
              <p class="text-xs font-semibold text-slate-500"><%= t("admin.teachers.index.school_role") %></p>
              <% role_classes =
                   case row[:school_role]
                   when "manager" then "bg-violet-100 text-violet-700"
                   when "member" then "bg-sky-100 text-sky-700"
                   else "bg-slate-100 text-slate-600"
                   end %>
              <span class="mt-1 inline-flex rounded-full px-2 py-1 text-xs font-semibold <%= role_classes %>"><%= row[:school_role_label] %></span>
            </div>

            <div class="min-w-0">
              <p class="text-xs font-semibold text-slate-500"><%= t("admin.teachers.index.classrooms") %></p>
              <div class="mt-1 flex flex-wrap gap-1.5">
                <% if classrooms.any? %>
                  <% classrooms.each do |classroom| %>
                    <span class="inline-flex rounded-full border border-slate-200 bg-white px-2 py-1 text-xs font-medium text-slate-700"><%= classroom_display_name(classroom) %></span>
                  <% end %>
                <% else %>
                  <span class="inline-flex rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600"><%= t("admin.teachers.index.unassigned_classroom") %></span>
                <% end %>
              </div>
            </div>

            <div class="flex flex-wrap justify-start gap-2 lg:justify-end">
              <%= link_to t("admin.teachers.index.manage"),
                    edit_admin_teacher_path(teacher),
                    class: "inline-flex rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="px-5 py-10 text-center">
        <p class="text-sm text-slate-500"><%= t("admin.teachers.index.empty") %></p>
        <%= link_to t("admin.teachers.index.add_teacher"),
              new_admin_teacher_path,
              class: "mt-4 inline-flex rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-100" %>
      </div>
    <% end %>
  </section>
</section>

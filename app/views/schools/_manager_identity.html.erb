<%# locals: (user:) %>
<div class="flex min-w-0 items-center gap-3">
  <%= user_avatar_image(
        user,
        size: 128,
        class: "h-10 w-10 shrink-0 rounded-xl border border-slate-200 bg-slate-100 object-cover",
        alt: "#{display_name(user)} avatar"
      ) %>
  <p class="truncate text-sm font-semibold text-slate-900"><%= display_name(user) %></p>
</div>

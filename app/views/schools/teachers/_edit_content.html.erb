<header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div class="min-w-0">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900"><%= t("schools.teachers.edit_title") %></h1>
    <p class="mt-1 truncate text-base font-semibold text-slate-600"><%= display_name(@teacher) %></p>
  </div>
  <%= link_to t("schools.teachers.back_to_index"),
        school_teachers_path(@school),
        class: "inline-flex items-center justify-center self-start rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
</header>

<% if @teacher.errors.any? %>
  <div class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700">
    <%= @teacher.errors.full_messages.to_sentence %>
  </div>
<% end %>

<section class="rounded-2xl border border-slate-200 bg-white p-5 text-sm shadow-sm">
  <h2 class="text-base font-semibold text-slate-900"><%= t("admin.teachers.info_title") %></h2>
  <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-start">
    <%= user_avatar_image(
          @teacher,
          size: 128,
          class: "h-20 w-20 shrink-0 rounded-xl border border-slate-200 bg-slate-100 object-cover",
          alt: "#{display_name(@teacher)} avatar"
        ) %>
    <dl class="grid min-w-0 flex-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs font-semibold text-slate-500"><%= t("ui.user_labels.name") %></dt>
        <dd class="mt-1 font-semibold text-slate-900"><%= display_name(@teacher) %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-slate-500"><%= t("ui.user_labels.email") %></dt>
        <dd class="mt-1 break-all text-slate-800"><%= @teacher.email %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-slate-500"><%= t("schools.teachers.form.gender_label") %></dt>
        <dd class="mt-1 text-slate-800">
          <% if %w[male female].include?(@teacher.gender) %>
            <%= t("schools.teachers.form.gender_#{@teacher.gender}") %>
          <% else %>
            <%= t("schools.teachers.form.gender_prompt") %>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-slate-500"><%= t("teacher_status.filter_label") %></dt>
        <dd class="mt-1">
          <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold <%= @teacher.active? ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-600" %>"><%= t(@teacher.active? ? "teacher_status.active" : "teacher_status.inactive") %></span>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-slate-500"><%= t("schools.teachers.form.school_label") %></dt>
        <dd class="mt-1 flex items-center gap-1.5 text-slate-800">
          <span aria-hidden="true" class="h-2.5 w-2.5 shrink-0 rounded-full <%= school_color_swatch_class(@school.color_key) %>"></span>
          <%= @school.name %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-slate-500"><%= t("admin.teachers.index.school_role") %></dt>
        <% role_classes = @school_membership.manager? ? "bg-violet-100 text-violet-700" : "bg-sky-100 text-sky-700" %>
        <dd class="mt-1">
          <span class="inline-flex rounded-full px-2 py-1 text-xs font-semibold <%= role_classes %>"><%= t(@school_membership.manager? ? "admin.teachers.index.manager" : "admin.teachers.index.member") %></span>
        </dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs font-semibold text-slate-500"><%= t("admin.teachers.index.classrooms") %></dt>
        <dd class="mt-1 flex flex-wrap gap-1.5">
          <% if @teacher_classroom_ids.any? %>
            <% @classrooms.select { |classroom| @teacher_classroom_ids.include?(classroom.id) }.each do |classroom| %>
              <span class="inline-flex rounded-full border border-slate-200 bg-white px-2 py-1 text-xs font-medium text-slate-700"><%= classroom_display_name(classroom) %></span>
            <% end %>
          <% else %>
            <span class="inline-flex rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600"><%= t("admin.teachers.index.unassigned_classroom") %></span>
          <% end %>
        </dd>
      </div>
    </dl>
  </div>
</section>

<%= form_with model: @teacher,
      url: school_teacher_path(@school, @teacher),
      method: :patch,
      class: "space-y-6" do |f| %>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 text-sm shadow-sm">
    <%= render "classroom_fields",
          classrooms: @classrooms,
          selected_classroom_ids: @teacher_classroom_ids %>

    <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
      <%= f.submit t("ui.save"),
            data: { turbo_submits_with: t("schools.teachers.form.submitting") },
            class: "inline-flex justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
    </div>
  </section>
<% end %>

<section class="rounded-2xl border border-rose-200 bg-rose-50/40 p-5 text-sm">
  <h2 class="text-base font-semibold text-rose-900"><%= t("admin.teachers.account_status.title") %></h2>
  <div class="mt-3 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <span class="inline-flex self-start rounded-full px-2 py-0.5 text-xs font-semibold <%= @teacher.active? ? "bg-emerald-100 text-emerald-700" : "bg-slate-200 text-slate-600" %>"><%= t(@teacher.active? ? "teacher_status.active" : "teacher_status.inactive") %></span>
    <% action = @teacher.active? ? :deactivate_teacher? : :reactivate_teacher? %>
    <% if policy(@teacher).public_send(action) %>
      <% if @teacher.active? %>
        <%= button_to t("teacher_status.deactivate"),
              deactivate_school_teacher_path(@school, @teacher),
              method: :patch,
              form: { data: { turbo_confirm: t("teacher_status.confirm_deactivate") } },
              class: "inline-flex justify-center rounded-lg border border-rose-300 bg-white px-4 py-2 font-semibold text-rose-700 hover:bg-rose-50" %>
      <% else %>
        <%= button_to t("teacher_status.reactivate"),
              reactivate_school_teacher_path(@school, @teacher),
              method: :patch,
              class: "inline-flex justify-center rounded-lg border border-emerald-300 bg-white px-4 py-2 font-semibold text-emerald-700 hover:bg-emerald-50" %>
      <% end %>
    <% end %>
  </div>
</section>

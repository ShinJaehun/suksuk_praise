<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <h2 class="text-base font-bold text-slate-900"><%= t("schools.settings.name_title") %></h2>
  <%= form_with model: @school, class: "mt-3 space-y-3" do |form| %>
    <div>
      <%= form.label :name, t("schools.settings.name_label"), class: "block text-sm font-semibold text-slate-800" %>
      <%= form.text_field :name, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      <% if @school.errors[:name].any? %>
        <p class="mt-1 text-sm text-rose-600"><%= @school.errors.full_messages_for(:name).to_sentence %></p>
      <% end %>
    </div>
    <%= form.submit t("schools.settings.name_submit"),
          data: { turbo_submits_with: t("ui.processing") },
          class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white" %>
  <% end %>
</section>

<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <h2 class="text-base font-bold text-slate-900"><%= t("schools.settings.color_title") %></h2>
  <p class="mt-1 text-sm text-slate-500"><%= t("schools.settings.color_description") %></p>

  <%= form_with model: @school, class: "mt-3 space-y-3" do |form| %>
    <fieldset>
      <legend class="sr-only"><%= t("schools.settings.color_label") %></legend>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <% School::COLOR_KEYS.each do |color_key| %>
          <label class="relative cursor-pointer">
            <%= form.radio_button :color_key,
                  color_key,
                  class: "peer sr-only" %>
            <span class="flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 peer-checked:border-slate-900 peer-checked:ring-2 peer-checked:ring-slate-300 peer-focus-visible:ring-2 peer-focus-visible:ring-sky-500">
              <span class="h-4 w-4 shrink-0 rounded-full <%= school_color_swatch_class(color_key) %>"></span>
              <%= t("schools.settings.colors.#{color_key}") %>
            </span>
          </label>
        <% end %>
      </div>
      <% if @school.errors[:color_key].any? %>
        <p class="mt-2 text-sm text-rose-600"><%= @school.errors.full_messages_for(:color_key).to_sentence %></p>
      <% end %>
    </fieldset>
    <%= form.submit t("schools.settings.color_submit"),
          data: { turbo_submits_with: t("ui.processing") },
          class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white" %>
  <% end %>
</section>

<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <h2 class="text-base font-bold text-slate-900"><%= t("schools.settings.managers_title") %></h2>
  <div class="mt-3 space-y-2">
    <% if @managers.any? %>
      <% @managers.each do |membership| %>
        <div class="flex items-center justify-between gap-3">
          <%= render "schools/manager_identity", user: membership.user %>
          <%= link_to t("schools.settings.manager_remove"),
                admin_school_manager_path(@school, membership.user),
                data: { turbo_method: :delete, turbo_confirm: t("schools.settings.manager_remove_confirm") },
                class: "text-sm font-semibold text-rose-700" %>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm text-slate-500"><%= t("schools.show.administrators_empty") %></p>
    <% end %>
  </div>

  <%= form_with url: admin_school_school_managers_path(@school), class: "mt-4 space-y-3" do |form| %>
    <div>
      <%= form.label :user_id, t("schools.settings.manager_candidate_label"), class: "block text-sm font-semibold text-slate-800" %>
      <%= form.collection_select :user_id,
            @manager_candidates,
            :id,
            :name,
            { prompt: t("schools.settings.manager_prompt") },
            { class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" } %>
    </div>
    <%= form.submit t("schools.settings.manager_assign"),
          data: { turbo_submits_with: t("ui.processing") },
          class: "rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white" %>
  <% end %>
</section>

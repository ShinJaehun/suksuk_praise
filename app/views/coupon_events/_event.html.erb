<%# locals: (event:) %>
<% return_to = "#{request.fullpath}##{dom_id(event, :activity_notes)}" %>
<li class="rounded-lg border border-slate-200 bg-slate-50 text-sm"
    data-activity-source="CouponEvent"
    data-activity-source-id="<%= event.id %>">
  <div class="flex flex-wrap items-center gap-2 px-3 py-2" data-activity-log-line>
    <span class="font-semibold text-slate-800"><%= event.classroom&.name || "-" %></span>
    <span class="text-slate-400">→</span>
    <span class="font-semibold text-slate-800"><%= event.metadata["target_user_name"].presence || event.user_coupon&.user&.name || "-" %></span>
    <span class="text-slate-400">·</span>
    <span class="font-semibold text-slate-900"><%= event.coupon_template&.title || "-" %></span>
    <% badge_class = event.action == "issued" ?
         "rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700" :
         "rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700" %>
    <span class="<%= badge_class %>"><%= t("coupon_events.action.#{event.action}", default: event.action) %></span>
    <span class="text-xs text-slate-500">by <%= event.actor&.name || event.actor&.email || "-" %></span>
    <span class="text-xs text-slate-500">(<%= l event.created_at, format: :short %>)</span>
    <%= turbo_frame_tag dom_id(event, :activity_notes), class: "contents" do %>
      <%= render "student_activity_notes/panel",
            source: event,
            notes: event.student_activity_notes,
            current_user: current_user,
            return_to: return_to %>
    <% end %>
  </div>
</li>

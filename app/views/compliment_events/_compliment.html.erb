<%# locals: (compliment:) %>
<% return_to = "#{request.fullpath}##{dom_id(compliment, :activity_notes)}" %>
<li class="rounded-lg border border-slate-200 bg-slate-50 text-sm"
    data-activity-source="Compliment"
    data-activity-source-id="<%= compliment.id %>">
  <div class="flex flex-col gap-1 px-3 py-2 sm:flex-row sm:flex-wrap sm:items-center sm:gap-2">
    <span class="font-semibold text-slate-800"><%= compliment.classroom&.name || t("compliment_events.index.unknown_classroom") %></span>
    <span class="hidden text-slate-400 sm:inline">→</span>
    <span class="font-semibold text-slate-800"><%= compliment.receiver&.name || t("compliment_events.index.unknown_user") %></span>
    <span class="text-slate-700"><%= t("compliment_events.index.received_from", name: compliment.giver&.name || compliment.giver&.email || t("compliment_events.index.unknown_user")) %></span>
    <% if compliment.reason.present? %>
      <span class="inline-flex w-fit rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800"><%= compliment.reason %></span>
    <% end %>
    <span class="text-xs text-slate-500">(<%= l compliment.given_at, format: :short %>)</span>
  </div>
  <%= turbo_frame_tag dom_id(compliment, :activity_notes) do %>
    <%= render "student_activity_notes/panel",
          source: compliment,
          notes: compliment.student_activity_notes,
          current_user: current_user,
          return_to: return_to %>
  <% end %>
</li>

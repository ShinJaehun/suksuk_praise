<%# locals: (note:, source:, return_to:) %>
<% cancel_to = return_to.to_s.sub(/#.*\z/, "") %>
<div class="mt-2 basis-full w-full border-t border-slate-200 bg-slate-100/70 p-3">
  <% if note.errors.any? %>
    <p class="mb-2 text-sm text-rose-600"><%= note.errors.full_messages.to_sentence %></p>
  <% end %>

  <%= form_with model: note,
        url: note.persisted? ?
          student_activity_note_path(note, return_to: return_to) :
          student_activity_notes_path(source_type: source.model_name.name, source_id: source.id, return_to: return_to),
        class: "space-y-2" do |form| %>
    <%= form.text_area :body,
          rows: 4,
          maxlength: 1_000,
          autofocus: true,
          placeholder: t("student_activity_notes.placeholder"),
          class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %>
    <div class="flex justify-end gap-2">
      <%= form.submit t("ui.save"),
            class: "rounded-lg bg-sky-600 px-3 py-2 text-sm font-semibold text-white hover:bg-sky-700" %>
      <%= link_to t("ui.cancel"),
            cancel_to,
            data: {
              turbo_frame: dom_id(source, :activity_notes),
              activity_note_action: "cancel"
            },
            class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700" %>
    </div>
  <% end %>
</div>

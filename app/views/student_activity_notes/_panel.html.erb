<%# locals: (source:, notes:, current_user:, return_to:) %>
<% ordered_notes = notes.to_a.sort_by { |note| [note.created_at, note.id] } %>
<% current_user_note = ordered_notes.find { |note| note.author_id == current_user.id } %>
<% draft_note = StudentActivityNote.new(source: source, author: current_user) %>

<% if current_user_note.nil? && policy(draft_note).create? %>
  <%= link_to t("student_activity_notes.actions.new"),
        new_student_activity_note_path(
          source_type: source.model_name.name,
          source_id: source.id,
          return_to: return_to
        ),
        data: {
          turbo_frame: dom_id(source, :activity_notes),
          activity_note_action: "new"
        },
        class: "inline-flex rounded border border-slate-300 bg-white px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50" %>
<% end %>

<% if ordered_notes.any? %>
  <div class="mt-2 basis-full w-full border-t border-slate-200 bg-slate-100/70 px-3 py-2"
       data-student-activity-note-panel>
    <% ordered_notes.each do |note| %>
      <%= render "student_activity_notes/note",
            note: note,
            source: source,
            return_to: return_to %>
    <% end %>
  </div>
<% end %>

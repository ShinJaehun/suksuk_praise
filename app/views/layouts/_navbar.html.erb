<% context = navigation_context %>
<% primary_items = primary_navigation_items(context) %>
<% classroom_navigation = teacher_classroom_navigation(context) %>
<% management_groups = management_navigation_groups %>
<% account = navigation_account(context) %>

<div class="h-14 w-full max-w-6xl mx-auto flex items-center justify-between px-4 sm:px-6 lg:px-8"
     data-navigation-root="navbar">
  <div class="flex items-center gap-4">
    <%= link_to root_path, class: "flex items-center" do %>
      <%= image_tag "suksuk_logo.png",
            alt: t("navigation.brand"),
            class: "h-8 w-auto" %>
    <% end %>

    <%= render "layouts/navigation/desktop",
          primary_items: primary_items,
          classroom_navigation: classroom_navigation,
          management_groups: management_groups %>
  </div>

  <%= render "layouts/navigation/mobile",
        account: account,
        primary_items: primary_items,
        classroom_navigation: classroom_navigation,
        management_groups: management_groups %>
</div>

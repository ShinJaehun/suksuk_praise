<%= turbo_frame_tag :modal do %>
  <% boy_avatar_keys = User.avatar_keys_for("boy") %>
  <% girl_avatar_keys = User.avatar_keys_for("girl") %>
  <% boy_avatar_urls = boy_avatar_keys.map { |key| asset_path("avatars/#{key}.png") } %>
  <% girl_avatar_urls = girl_avatar_keys.map { |key| asset_path("avatars/#{key}.png") } %>

  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
       data-controller="modal"
       role="dialog"
       aria-modal="true">
    <div class="max-h-[calc(100vh-2rem)] w-full max-w-4xl overflow-hidden rounded-lg bg-white p-6 shadow-lg">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-xl font-bold text-slate-900"><%= t("students.members.actions.edit_names") %></h2>
          <p class="mt-1 text-sm text-slate-600"><%= t("students.members.update_names.description") %></p>
        </div>
        <button type="button"
                data-action="modal#close"
                class="text-2xl leading-none text-slate-400 hover:text-slate-600"
                aria-label="<%= t("ui.cancel") %>">&times;</button>
      </div>

      <% if flash.now[:alert].present? %>
        <div class="mt-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700">
          <%= flash.now[:alert] %>
        </div>
      <% end %>

      <%= form_with url: classroom_member_student_names_path(@classroom, status: @member_status),
            method: :patch,
            data: {
              controller: "student-roster-editor",
              turbo_frame: :modal,
              turbo_submits_with: t("ui.processing"),
              student_roster_editor_avatar_alt_value: t("students.members.update_names.avatar_alt"),
              student_roster_editor_boy_avatar_keys_value: boy_avatar_keys.to_json,
              student_roster_editor_boy_avatar_urls_value: boy_avatar_urls.to_json,
              student_roster_editor_girl_avatar_keys_value: girl_avatar_keys.to_json,
              student_roster_editor_girl_avatar_urls_value: girl_avatar_urls.to_json
            },
            html: { id: "student_names_form", class: "mt-4 space-y-4" } do %>
        <div class="mb-2 hidden grid-cols-[6rem_minmax(12rem,1fr)_9rem_5rem_5rem] gap-3 px-3 text-xs font-semibold text-slate-500 md:grid">
          <span><%= t("students.members.update_names.student_number") %></span>
          <span><%= t("students.members.update_names.name") %></span>
          <span><%= t("students.members.update_names.gender") %></span>
          <span><%= t("students.members.update_names.avatar") %></span>
          <span><%= t("students.members.update_names.status") %></span>
        </div>

        <div class="max-h-[60vh] space-y-3 overflow-y-auto pr-1">
          <% @student_name_memberships.each_with_index do |membership, position| %>
            <%= render "classrooms/members/student_roster_edit_row",
                  membership: membership,
                  position: position,
                  submitted_attrs: (@submitted_student_roster || {})[membership.id.to_s],
                  row_errors: (@student_roster_errors_by_membership_id || {})[membership.id.to_s] %>
          <% end %>
        </div>

        <div class="flex flex-wrap justify-end gap-2 border-t border-slate-200 pt-4">
          <button type="button"
                  data-action="modal#close"
                  class="inline-flex min-h-10 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">
            <%= t("ui.cancel") %>
          </button>
          <%= submit_tag t("students.members.update_names.submit"),
                class: "inline-flex min-h-10 items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

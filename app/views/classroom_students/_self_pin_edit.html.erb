<section class="mx-auto w-full max-w-3xl space-y-6 pt-4">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900"><%= t("students.edit.self_pin.title") %></h1>
    <%= link_to t("students.edit.back_to_student"),
          classroom_student_path(@classroom, @student),
          class: "inline-flex items-center justify-center self-start rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
  </header>

  <% if @student.errors.any? %>
    <div role="alert"
         class="rounded-2xl border border-rose-200 bg-rose-50 px-5 py-4 text-sm font-medium text-rose-700 shadow-sm">
      <%= @student.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-base font-semibold text-slate-900"><%= t("students.edit.self_pin.info_title") %></h2>
    <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-start">
      <%= user_avatar_image(
            @student,
            size: 128,
            class: "h-20 w-20 shrink-0 rounded-xl border border-slate-200 bg-slate-100 object-cover",
            alt: "#{@student.name} avatar"
          ) %>
      <dl class="grid min-w-0 flex-1 gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-xs font-semibold text-slate-500"><%= t("ui.user_labels.name") %></dt>
          <dd class="mt-1 font-semibold text-slate-900"><%= @student.name %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-slate-500"><%= t("students.edit.self_pin.gender") %></dt>
          <dd class="mt-1 text-slate-800"><%= t("students.edit.self_pin.genders.#{@student.gender}", default: t("students.edit.self_pin.genders.unspecified")) %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-slate-500"><%= t("students.edit.self_pin.created_at") %></dt>
          <dd class="mt-1 text-slate-800"><%= l(@student.created_at, format: :short) %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-slate-500"><%= t("students.edit.self_pin.school") %></dt>
          <dd class="mt-1 text-slate-800">
            <%= @classroom.school&.name || t("students.edit.self_pin.unassigned_school") %>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-slate-500"><%= t("students.edit.self_pin.grade") %></dt>
          <dd class="mt-1 text-slate-800">
            <% if @classroom.grade.present? %>
              <%= t("classrooms.index.grade", grade: @classroom.grade) %>
            <% else %>
              <%= t("students.edit.self_pin.unassigned_grade") %>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold text-slate-500"><%= t("students.edit.self_pin.classroom") %></dt>
          <dd class="mt-1 text-slate-800"><%= @classroom.name %></dd>
        </div>
        <div data-testid="student-number">
          <dt class="text-xs font-semibold text-slate-500"><%= t("students.edit.self_pin.student_number") %></dt>
          <dd class="mt-1 text-slate-800">
            <% if @student_membership.student_number.present? %>
              <%= t("students.edit.self_pin.student_number_value", number: @student_membership.student_number) %>
            <% else %>
              <%= t("students.edit.self_pin.unassigned_student_number") %>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-base font-semibold text-slate-900"><%= t("students.edit.self_pin.form_title") %></h2>
    <%= form_with model: @student,
          url: classroom_student_path(@classroom, @student),
          method: :patch,
          class: "mt-4 space-y-5" do |f| %>
      <div>
        <%= f.label :student_pin, t("students.edit.self_pin.new_pin"), class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.password_field :student_pin,
              value: nil,
              maxlength: 4,
              inputmode: "numeric",
              pattern: "\\d{4}",
              autocomplete: "new-password",
              class: "block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>
      <div>
        <%= f.label :student_pin_confirmation, t("students.edit.self_pin.confirmation"), class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= f.password_field :student_pin_confirmation,
              value: nil,
              maxlength: 4,
              inputmode: "numeric",
              pattern: "\\d{4}",
              autocomplete: "new-password",
              class: "block w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>
      <div class="flex justify-end">
        <%= f.submit t("students.edit.self_pin.submit"),
              data: { turbo_submits_with: t("ui.processing") },
              class: "inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
      </div>
    <% end %>
  </section>
</section>

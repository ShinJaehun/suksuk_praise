<%= turbo_frame_tag :modal do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50"
       data-controller="modal"
       role="dialog"
       aria-modal="true">
    <div class="relative w-full max-w-md rounded-lg bg-white p-8 shadow-lg">
      <h2 class="mb-4 text-xl font-bold"><%= t("ui.buttons.bulk_create_students") %></h2>
      <% student_count_value = local_assigns.fetch(:student_count, remaining_capacity) %>
      <% student_pin_value = local_assigns.fetch(:student_pin, nil) %>

      <%= form_with url: bulk_preview_classroom_students_path(classroom),
            method: :post,
            html: { id: "bulk-student-setup-form" },
            data: { turbo_frame: :modal, turbo_submits_with: t("ui.processing") } do |f| %>
        <%= hidden_field_tag :return_to, return_to if local_assigns[:return_to].present? %>

        <% if local_assigns[:error_message].present? %>
          <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700">
            <%= error_message %>
          </div>
        <% end %>

        <p class="mb-4 text-sm text-slate-600">
          <%= t("students.bulk_create.setup.remaining_capacity", count: remaining_capacity) %>
        </p>

        <div class="mb-4">
          <%= f.label :student_count, t("students.bulk_create.setup.student_count") %>
          <%= f.number_field :student_count,
                value: student_count_value,
                min: 1,
                max: remaining_capacity,
                step: 1,
                inputmode: "numeric",
                required: true,
                class: "mt-1 w-full rounded border px-2 py-1" %>
        </div>

        <div class="mb-4">
          <%= f.label :student_pin, t("students.bulk_create.setup.student_pin") %>
          <%= f.password_field :student_pin,
                value: student_pin_value,
                maxlength: 4,
                inputmode: "numeric",
                pattern: "\\d{4}",
                required: true,
                class: "mt-1 w-full rounded border px-2 py-1" %>
        </div>

        <div class="flex gap-2">
          <button type="button" data-action="modal#close" class="rounded bg-gray-300 px-4 py-2">
            <%= t("ui.cancel") %>
          </button>
          <%= f.submit t("students.bulk_create.actions.preview"),
                class: "rounded bg-blue-500 px-4 py-2 text-white" %>
        </div>
      <% end %>

      <button type="button"
              data-action="modal#close"
              class="absolute right-2 top-2 text-2xl text-gray-400 hover:text-gray-600"
              aria-label="<%= t("ui.cancel") %>">&times;</button>
    </div>
  </div>
<% end %>

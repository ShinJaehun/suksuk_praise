<%= turbo_frame_tag :modal do %>
  <% boy_avatar_keys = User.avatar_keys_for("boy") %>
  <% girl_avatar_keys = User.avatar_keys_for("girl") %>
  <% boy_avatar_urls = boy_avatar_keys.map { |key| asset_path("avatars/#{key}.png") } %>
  <% girl_avatar_urls = girl_avatar_keys.map { |key| asset_path("avatars/#{key}.png") } %>

  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50"
       data-controller="modal"
       role="dialog"
       aria-modal="true">
    <div class="relative max-h-[calc(100vh-2rem)] w-full max-w-4xl overflow-hidden rounded-lg bg-white p-6 shadow-lg">
      <h2 class="mb-4 text-xl font-bold"><%= t("students.bulk_create.preview.title") %></h2>

      <% if local_assigns[:error_message].present? %>
        <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700">
          <%= error_message %>
        </div>
      <% end %>

      <%= form_with url: bulk_create_classroom_students_path(classroom),
            method: :post,
            html: { id: "bulk-student-preview-form" },
            data: {
              controller: "bulk-student-draft",
              turbo_frame: :modal,
              action: "submit->modal#showProgress",
              turbo_submits_with: t("ui.processing"),
              bulk_student_draft_avatar_alt_value: t("students.bulk_create.preview.avatar_alt"),
              bulk_student_draft_count_label_value: t("students.bulk_create.preview.total", count: "%{count}"),
              bulk_student_draft_max_rows_value: remaining_capacity,
              bulk_student_draft_boy_avatar_keys_value: boy_avatar_keys.to_json,
              bulk_student_draft_boy_avatar_urls_value: boy_avatar_urls.to_json,
              bulk_student_draft_girl_avatar_keys_value: girl_avatar_keys.to_json,
              bulk_student_draft_girl_avatar_urls_value: girl_avatar_urls.to_json
            } do %>
        <%= hidden_field_tag :return_to, return_to if local_assigns[:return_to].present? %>
        <%= hidden_field_tag :student_pin, student_pin %>
        <%= hidden_field_tag :student_count,
              student_drafts.size,
              data: { bulk_student_draft_target: "studentCount" } %>

        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
          <div class="text-sm font-semibold text-slate-700" data-bulk-student-draft-target="count">
            <%= t("students.bulk_create.preview.total", count: student_drafts.size) %>
          </div>
          <button type="button"
                  data-bulk-student-draft-target="addButton"
                  data-action="bulk-student-draft#add"
                  class="inline-flex items-center justify-center rounded-lg border border-sky-300 bg-white px-3 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-50 disabled:cursor-not-allowed disabled:opacity-50">
            <%= t("students.bulk_create.actions.add_row") %>
          </button>
        </div>

        <div class="mb-2 hidden grid-cols-[5.5rem_minmax(12rem,1fr)_9rem_5rem_5rem] gap-3 px-3 text-xs font-semibold text-slate-500 md:grid">
          <span><%= t("students.bulk_create.preview.student_number") %></span>
          <span><%= t("students.bulk_create.preview.name") %></span>
          <span><%= t("students.bulk_create.preview.gender") %></span>
          <span><%= t("students.bulk_create.preview.avatar") %></span>
          <span><%= t("students.bulk_create.preview.actions") %></span>
        </div>

        <div id="bulk-student-draft-list"
             class="max-h-[55vh] space-y-3 overflow-y-auto pr-1"
             data-bulk-student-draft-target="list">
          <% student_drafts.each do |draft| %>
            <%= render "classroom_students/student_draft_row",
                  draft: draft,
                  draft_error: (local_assigns[:draft_errors] || {})[draft[:index]] %>
          <% end %>
        </div>

        <template data-bulk-student-draft-target="template">
          <%= render "classroom_students/student_draft_row",
                draft: { index: "__ROW_KEY__", student_number: "", name: "", gender: "", avatar_key: "" },
                draft_error: nil %>
        </template>

        <div data-modal-target="progress" class="mt-4 hidden w-full">
          <div class="h-2 w-full rounded bg-gray-200">
            <div class="bar h-2 rounded bg-blue-500 transition-all" style="width: 70%"></div>
          </div>
        </div>

        <div class="mt-5 flex flex-wrap justify-end gap-2 border-t border-slate-100 pt-4">
          <%= button_tag t("students.bulk_create.actions.back"),
                type: "submit",
                name: "back",
                value: "1",
                formaction: bulk_preview_classroom_students_path(classroom),
                formmethod: "post",
                class: "inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
          <%= submit_tag t("ui.buttons.bulk_create_students"),
                class: "inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
        </div>
      <% end %>

      <button type="button"
              data-action="modal#close"
              class="absolute right-2 top-2 text-2xl text-gray-400 hover:text-gray-600"
              aria-label="<%= t("ui.cancel") %>">&times;</button>
    </div>
  </div>
<% end %>
